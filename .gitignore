# Dependencies
node_modules/

# Local environment / secrets (real values live in Secret Manager, never here)
.env
.env.local
.env.*.local
*.key

# Logs
npm-debug.log*
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Per-developer name used by scripts/push-branch.ps1 — must never be committed.
# (A tracked copy once leaked the junk value '-Message' to every machine, which is
# why the cross-laptop sync briefly created branches named 'message/*'.)
scripts/.devname
